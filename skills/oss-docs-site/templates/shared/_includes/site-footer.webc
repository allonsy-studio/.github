<!--- Footer block: the project lock-up: name, links, license, & the studio credit. --->
<footer>
	<div>
		<div>
			<p><strong @text="$data.site.packageName || $data.site.name"></strong></p>
			<p @text="$data.site.tagline + '.'"></p>
			<p webc:if="$data.site.npmRelease" data-badges>
				<a :href="$data.site.npm"><img alt="npm version" :src="'https://img.shields.io/npm/v/' + $data.site.packageName + '?logo=npm&labelColor=black&color=%23' + $data.site.badgeColor" height="20" loading="lazy" /></a>
				<a :href="$data.site.npm"><img alt="npm weekly downloads" :src="'https://img.shields.io/npm/dw/' + $data.site.packageName + '?logo=npm&labelColor=black&color=%23' + $data.site.badgeColor" height="20" loading="lazy" /></a>
			</p>
			<p>
				<small>
					Licensed under
					<a :href="$data.site.licenseUrl" data-license @text="$data.site.license"></a>
				</small>
			</p>
		</div>
		<nav aria-label="Project links">
			<p><strong>Project</strong></p>
			<ul>
				<li><a :href="$data.site.repo"><fa-icon @name="brands/github"></fa-icon> GitHub</a></li>
				<li webc:if="$data.site.npm"><a :href="$data.site.npm"><fa-icon @name="brands/npm"></fa-icon> npm</a></li>
				<li><a :href="$data.site.changelogUrl"><fa-icon @name="clock-rotate-left"></fa-icon> Changelog</a></li>
			</ul>
		</nav>
		<nav aria-label="Help links">
			<p><strong>Help</strong></p>
			<ul>
				<li><a :href="$data.site.issuesUrl"><fa-icon @name="bug"></fa-icon> Report an issue</a></li>
				<li><a :href="$data.site.contributingUrl"><fa-icon @name="book-open"></fa-icon> Contributing guide</a></li>
				<li><a :href="$data.studio.conductUrl"><fa-icon @name="handshake"></fa-icon> Code of conduct</a></li>
				<li><a :href="$data.studio.securityUrl"><fa-icon @name="shield-halved"></fa-icon> Security policy</a></li>
			</ul>
		</nav>
		<studio-footer webc:if="$data.site.studio"></studio-footer>
	</div>
</footer>
