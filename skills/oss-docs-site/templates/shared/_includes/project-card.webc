<!--- Card. Props: title, body, href (optional), icon (optional: "rocket", "brands/github"). --->
<article>
	<span webc:if="icon" aria-hidden="true"><fa-icon :@name="icon"></fa-icon></span>
	<h3>
		<a webc:if="href" :href="href" @text="title"></a>
		<span webc:else @text="title"></span>
	</h3>
	<p @text="body"></p>
</article>
