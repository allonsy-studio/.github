<!--- Card. Props: title, body, href (optional), icon (optional: "rocket", "brands/github"), image (optional: a path; wins over icon). --->
<article>
	<img webc:if="image" :src="image" alt="" width="48" height="48" />
	<span webc:elseif="icon" aria-hidden="true"><fa-icon :@name="icon"></fa-icon></span>
	<h3>
		<a webc:if="href" :href="href" @text="title"></a>
		<span webc:else @text="title"></span>
	</h3>
	<p @text="body"></p>
</article>
