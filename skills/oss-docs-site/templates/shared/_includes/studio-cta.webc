<!--- Studio layer: locked. Renders from site data; takes no props or slots. --->
<section data-studio="cta">
	<img
		:src="$data.studio.mark.src"
		alt=""
		:width="$data.studio.mark.width"
		:height="$data.studio.mark.height"
		loading="lazy"
	/>
	<div>
		<p webc:if="$data.studio.cta.eyebrow"><template webc:nokeep @html="$data.studio.cta.eyebrowHtml"></template></p>
		<h2><template webc:nokeep @html="$data.studio.cta.titleHtml"></template></h2>
		<p @text="$data.studio.cta.body"></p>
	</div>
	<ul>
		<li webc:for="action of $data.studio.cta.actions">
			<a :href="action.href" @text="action.label"></a>
		</li>
	</ul>
</section>
