---
layout: base.webc
---
<docs-shell
	:@items="$data.workspaces"
	:@heading="$data.workspace.name"
	:@icon="$data.workspace.icon"
	:@wordmark="$data.workspace.wordmark"
>
	<p webc:if="$data.workspace.description" @text="$data.workspace.description"></p>
	<template webc:nokeep @html="$data.workspace.html"></template>
</docs-shell>
