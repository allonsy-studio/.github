---
layout: base.webc
---
<header>
	<h1>
		<span @text="$data.site.name"></span>
		<span @text="$data.site.tagline"></span>
	</h1>
	<p @text="$data.project.lede || $data.site.description"></p>
	<nav aria-label="Get started">
		<ul>
			<li webc:if="$data.collections.docs.length"><a :href="$data.collections.docs[0].url"><fa-icon @name="book-open"></fa-icon> Read the docs</a></li>
			<li><a :href="$data.site.repo"><fa-icon @name="brands/github"></fa-icon> View on GitHub</a></li>
		</ul>
	</nav>
	<code-sample
		language="sh"
		:@code="$data.project.install || 'npm install ' + $data.site.packageName"
		@anchor="install"
	></code-sample>
</header>

<section aria-labelledby="docs-title">
	<h2 id="docs-title">Documentation</h2>
	<ul>
		<li webc:for="page of $data.collections.docs">
			<project-card :@title="page.data.title" :@body="page.data.description" :@href="page.url"></project-card>
		</li>
	</ul>
</section>
